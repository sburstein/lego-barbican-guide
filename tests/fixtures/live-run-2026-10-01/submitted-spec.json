{
  "id": "barbican-estate",
  "title": "Barbican Estate",
  "subtitle": "City of London, 1965-1976",
  "description": "Chamberlin, Powell and Bon's Brutalist Barbican: three serrated residential towers rise behind a lakeside terrace block crowned by barrel vaults. Everything stands on the raised pedestrian podium.",
  "concept": "A city within the city, raised on a podium beside the water.",
  "site": {
    "w": 32,
    "d": 20
  },
  "elements": [
    {
      "id": "lake",
      "name": "Barbican Lake",
      "type": "surface",
      "material": "water",
      "rects": [
        {
          "x": 1,
          "z": 14,
          "w": 28,
          "d": 5
        }
      ],
      "concept": "Water as a soft foil to the concrete.",
      "about": "The lake runs along the heart of the estate, and the terrace blocks are grouped around it and the gardens. Its still surface reflects the concrete and softens it.",
      "facts": [
        "Water features and gardens were planned as a soft visual foil to the concrete.",
        "The estate was built in 1965-1976 on a site bombed in the Second World War."
      ]
    },
    {
      "id": "quay",
      "name": "Lakeside edge",
      "type": "parts",
      "concept": "A crisp rim to the water.",
      "about": "A one-plate rim along the front edge of the lake. It finishes the display and ties the base plates together.",
      "facts": [
        "Tip: lay the long plates so that each one spans a joint between base plates."
      ],
      "items": [
