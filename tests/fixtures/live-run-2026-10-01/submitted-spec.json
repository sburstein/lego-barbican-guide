    {
      "id": "podium",
      "name": "Podium",
      "type": "podium",
      "rect": {
        "x": 0,
        "z": 0,
        "w": 32,
        "d": 13
      },
      "levels": 1,
      "style": "colonnade",
      "spacing": 3,
      "concept": "A pedestrian city above the street.",
      "about": "The podium is the raised deck that links the whole estate and keeps people on foot away from traffic. The towers and terraces rise from it on concrete columns.",
      "facts": [
        "Terrace blocks rise up to seven floors above the podium level.",
        "Most blocks stand on immense cylindrical concrete columns.",
        "Tip: set the columns first, then bridge the deck plates across them."
      ]
    },
    {
      "id": "cromwell",
      "name": "Cromwell Tower",
      "type": "parts",
      "concept": "Serrated balconies, floor by floor.",
      "about": "The westernmost tower, rising from the podium behind the lake. One of the Barbican's three residential towers, which dominate the City skyline at 42 storeys and about 123 m. Their jagged outline comes from balconies that wrap every floor, so the silhouette changes as you walk round.",
      "facts": [
        "The towers are triangular in plan, with serrated balcony silhouettes.",
        "Balcony edges are shaped like a boat hull, which reduces wind resistance.",
        "The topmost floors hold penthouse flats.",
        "Tip: turn each balcony slab 90 degrees from the one below to make the sawtooth edge."
      ],
